{
  "name": "chiptune-workstation",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run build && node --check src/app.js && npm run test:legacy && npm run v3:check",
    "test": "npm run build && npm run test:legacy && npm run v3:test",
    "test:legacy": "node --test \"tests/**/*.test.js\"",
    "v3:architecture": "depcruise --config dependency-cruiser.v3.cjs src/v3",
    "v3:build": "vite build --config vite.config.ts",
    "v3:check": "npm run v3:typecheck && npm run v3:lint && npm run v3:format && npm run v3:architecture && npm run v3:knip && npm run v3:test && npm run v3:build && npm run v3:size",
    "v3:dev": "vite --config vite.config.ts --open /v3.html",
    "v3:format": "prettier --check \"src/v3/**/*.{ts,tsx,css}\" v3.html vite.config.ts vitest.config.ts tsconfig.v3.json tsconfig.v3.tools.json eslint.config.js dependency-cruiser.v3.cjs knip.v3.jsonc",
    "v3:knip": "knip --config knip.v3.jsonc",
    "v3:lint": "eslint \"src/v3/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts",
    "v3:size": "size-limit",
    "v3:test": "vitest run --config vitest.config.ts",
    "v3:typecheck": "tsc --project tsconfig.v3.json --noEmit && tsc --project tsconfig.v3.tools.json --noEmit"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@size-limit/file": "13.0.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "dependency-cruiser": "18.2.0",
    "esbuild": "0.28.1",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "happy-dom": "20.11.6",
    "knip": "6.32.2",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@reduxjs/toolkit": "2.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "9.3.0",
    "react-resizable-panels": "4.12.3",
    "zod": "4.4.3"
  },
  "size-limit": [
    {
      "name": "V3 JavaScript and CSS",
      "path": [
        "dist-v3/assets/*.js",
        "dist-v3/assets/*.css"
      ],
      "limit": "120 kB"
    }
  ]
}
